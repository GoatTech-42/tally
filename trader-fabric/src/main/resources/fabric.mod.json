{
  "schemaVersion": 1,
  "id": "doughbay",
  "version": "${version}",
  "name": "Tally",
  "description": "Auction analysis and verified execution for DonutSMP: collects market data, values items, finds resale opportunities, and can execute exact-match trades. Community-maintained fork of GoNuts.",
  "authors": [
    "cody-raves"
  ],
  "contact": {
    "sources": "https://github.com/GoatTech-42/tally"
  },
  "license": [
    "MIT",
    "GPL-3.0-only"
  ],
  "environment": "client",
  "entrypoints": {
    "client": [
      "dev.doughbay.fabric.DoughBayClient"
    ]
  },
  "mixins": [
    "doughbay.client.mixins.json",
    "gonuts-staffwatch.mixins.json"
  ],
  "depends": {
    "fabricloader": ">=${loader_dependency}",
    "minecraft": "~${minecraft_version}",
    "java": "${java_dependency}",
    "fabric-api": "*"
  },
  "breaks": {
    "staffwatch": "*"
  }
}
